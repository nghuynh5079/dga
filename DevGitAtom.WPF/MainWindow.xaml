<Window x:Class="DevGitAtom.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="dev-git-atom" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#0d1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgPrimary"   Color="#0d1117"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#161b22"/>
        <SolidColorBrush x:Key="BgTertiary"  Color="#21262d"/>
        <SolidColorBrush x:Key="BorderColor" Color="#30363d"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#58a6ff"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3fb950"/>
        <SolidColorBrush x:Key="AccentRed"   Color="#ff7b72"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e6edf3"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8b949e"/>
        <SolidColorBrush x:Key="Mutating"    Color="#d29922"/>

        <!-- Atom button style -->
        <Style x:Key="AtomButton" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d"/>
                                <Setter Property="BorderBrush" Value="#58a6ff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#388bfd26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chain item style -->
        <Style x:Key="ChainItem" TargetType="Border">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Run button -->
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2ea043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2ea043"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#21262d"/>
                                <Setter Property="Foreground" Value="#484f58"/>
                                <Setter Property="BorderBrush" Value="#30363d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Top bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="5"/>    <!-- Splitter -->
            <RowDefinition Height="280" MinHeight="150"/>  <!-- Terminal -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App name -->
                <TextBlock Grid.Column="0" Text="dev-git-atom" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Foreground="#58a6ff"/>

                <!-- Working dir + branch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWorkingDir" Text="📁 Chọn thư mục..." 
                               Foreground="#8b949e" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBranch" Text="" Margin="12,0,0,0"
                               Foreground="#3fb950" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDirtyIndicator" Text="" Margin="6,0,0,0"
                               Foreground="#d29922" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Browse button -->
                <Button Grid.Column="3" Content="📂 Chọn thư mục" Click="BtnBrowse_Click"
                        Style="{StaticResource AtomButton}" Padding="10,5" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>  <!-- Atom list -->
                <ColumnDefinition Width="5"/>                    <!-- Splitter -->
                <ColumnDefinition Width="*"/>                    <!-- Chain builder -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Atom List -->
            <Border Grid.Column="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ATOMS" Foreground="#8b949e"
                               FontSize="11" FontWeight="Bold" Margin="14,14,14,8"
                               />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0">
                        <StackPanel x:Name="AtomListPanel" Margin="0,0,0,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#30363d" Cursor="SizeWE"/>

            <!-- RIGHT: Chain Builder -->
            <Grid Grid.Column="2" Background="#0d1117" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chain header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CHAIN BUILDER" Foreground="#8b949e"
                               FontSize="11" FontWeight="Bold"  VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🗑 Clear" Style="{StaticResource AtomButton}"
                            Padding="8,4" Click="BtnClearChain_Click" FontSize="12"/>
                </Grid>

                <!-- Chain Items (drag & drop zone) -->
                <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <!-- Empty state -->
                        <TextBlock x:Name="TxtChainEmpty"
                                   Text="← Click vào Atom bên trái để thêm vào chain"
                                   Foreground="#484f58" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="13"/>

                        <!-- Chain list -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel x:Name="ChainPanel" AllowDrop="True"
                                        Drop="ChainPanel_Drop" DragOver="ChainPanel_DragOver"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnRun" Content="▶  RUN CHAIN"
                            Style="{StaticResource RunButton}" Click="BtnRun_Click"
                            IsEnabled="False"/>
                    <Button Grid.Column="2" Content="💾 Save Preset" Style="{StaticResource AtomButton}"
                            Padding="12,8" Click="BtnSavePreset_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ HORIZONTAL SPLITTER ═══ -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      Background="#30363d" Cursor="SizeNS"/>

        <!-- ═══ TERMINAL (WebView2 + xterm.js) ═══ -->
        <Border Grid.Row="3" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Terminal top bar -->
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d"
                        BorderThickness="0,0,0,1" Padding="12,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#3fb950" Margin="0,0,6,0"/>
                            <TextBlock Text="TERMINAL" Foreground="#8b949e"
                                       FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Clear" Style="{StaticResource AtomButton}"
                                Padding="8,3" FontSize="11" Click="BtnClearTerminal_Click"/>
                    </Grid>
                </Border>

                <!-- xterm.js WebView -->
                <wv2:WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="Transparent"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
