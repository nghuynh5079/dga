<UserControl x:Class="DevGitAtom.WPF.UI.Components.AtomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="48">
    <Border Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Logo -->
                <ColumnDefinition Width="Auto"/> <!-- App/Window name -->
                <ColumnDefinition Width="*"/>    <!-- Custom inject content -->
                <ColumnDefinition Width="Auto"/> <!-- Window controls -->
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Image Grid.Column="0" Source="/Assets/logo.jpg" Width="28" Height="28" Margin="16,0,12,0" VerticalAlignment="Center" Stretch="Uniform" />

            <!-- Title -->
            <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBlue}"/>

            <!-- Custom injected content (e.g., branch name, actions) -->
            <ContentPresenter Grid.Column="2" Content="{Binding CenterContent, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              VerticalAlignment="Center" Margin="32,0,0,0"/>

            <!-- Window Controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnMinimize_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Content="—" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Maximize/Restore Button -->
                <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Content="☐" FontSize="16" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Click="BtnClose_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentRed}" Content="✕" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ff7b72"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
