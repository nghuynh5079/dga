<Window x:Class="DevGitAtom.WPF.UI.Dialogs.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình tham số" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/logo.ico"
        Background="#0d1117" Foreground="#e6edf3" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtTitle" Text="Cấu hình:" Foreground="#8b949e" FontWeight="Bold" Margin="0,0,0,12"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParamsPanel"/>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Click="BtnCancel_Click" Background="#21262d" Foreground="#e6edf3" 
                    BorderBrush="#30363d" BorderThickness="1" Padding="16,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Lưu" Click="BtnOk_Click" Background="#238636" Foreground="#ffffff" 
                    BorderBrush="#2ea043" BorderThickness="1" Padding="16,6" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
