<Window x:Class="DevGitAtom.WPF.UI.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lưu Preset" Height="180" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0d1117" Foreground="#e6edf3" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Tên Preset mới:" Foreground="#8b949e" Margin="0,0,0,8"/>
        
        <TextBox x:Name="TxtInput" Grid.Row="1" Background="#161b22" Foreground="#e6edf3" 
                 BorderBrush="#30363d" Padding="8" FontSize="14" Margin="0,0,0,16"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Click="BtnCancel_Click" Background="#21262d" Foreground="#e6edf3" 
                    BorderBrush="#30363d" BorderThickness="1" Padding="16,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Lưu" Click="BtnOk_Click" Background="#238636" Foreground="#ffffff" 
                    BorderBrush="#2ea043" BorderThickness="1" Padding="16,6" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
