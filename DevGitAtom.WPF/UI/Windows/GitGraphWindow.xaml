<Window x:Class="DevGitAtom.WPF.UI.Windows.GitGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Git Graph" Height="600" Width="800"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Text="GIT COMMIT GRAPH" Foreground="#58a6ff" FontWeight="Bold"/>
        </Border>
        
        <!-- Reusing the exact same TerminalWebView strategy for drawing the graph -->
        <wv2:WebView2 Grid.Row="1" x:Name="GraphWebView" DefaultBackgroundColor="Transparent"/>
    </Grid>
</Window>
