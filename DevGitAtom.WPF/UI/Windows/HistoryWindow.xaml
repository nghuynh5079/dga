<Window x:Class="DevGitAtom.WPF.UI.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:DevGitAtom.WPF.UI.Components"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Run History" Height="500" Width="700"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="pack://application:,,,/Assets/logo.ico"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <components:AtomTitleBar Grid.Row="0" Title="Run History" />
        
        <ListView Grid.Row="1" Margin="12" x:Name="LvHistory" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Thời gian" Width="140" DisplayMemberBinding="{Binding Timestamp}"/>
                    <GridViewColumn Header="Trạng thái" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsSuccess}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#ff7b72"/>
                                            <Setter Property="Text" Value="Failed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#3fb950"/>
                                                    <Setter Property="Text" Value="Success"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Workspace" Width="150" DisplayMemberBinding="{Binding Workspace}"/>
                    <GridViewColumn Header="Chain Summary" Width="280" DisplayMemberBinding="{Binding ChainSummary}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>

