<Window x:Class="DevGitAtom.WPF.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DevGitAtom" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#0d1117"
        FontFamily="Segoe UI"
        Icon="/Assets/logo.jpg">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Top bar -->
            <RowDefinition Height="28"/>   <!-- Menu bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="5"/>    <!-- Splitter -->
            <RowDefinition Height="280" MinHeight="150"/>  <!-- Terminal -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo -->
                    <ColumnDefinition Width="Auto"/> <!-- App name -->
                    <ColumnDefinition Width="*"/>    <!-- Drag space & info -->
                    <ColumnDefinition Width="Auto"/> <!-- Window controls -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0" Source="/Assets/logo.jpg" Width="28" Height="28" Margin="16,0,12,0" VerticalAlignment="Center" Stretch="Uniform" />

                <!-- App name -->
                <TextBlock Grid.Column="1" Text="DevGitAtom" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="15" Foreground="#58a6ff"/>

                <!-- Working dir + branch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <TextBlock x:Name="TxtWorkingDir" Text="📁 Chọn thư mục..." 
                               Foreground="#8b949e" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBranch" Text="" Margin="12,0,0,0"
                               Foreground="#3fb950" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDirtyIndicator" Text="" Margin="6,0,0,0"
                               Foreground="#d29922" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="📂 Chọn thư mục" Click="BtnBrowse_Click"
                            Style="{StaticResource AtomButton}" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize -->
                    <Button Click="BtnMinimize_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="#8b949e" Content="—" FontSize="14" Cursor="Hand" />
                    <!-- Maximize -->
                    <Button Click="BtnMaximize_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="#8b949e" Content="☐" FontSize="16" Cursor="Hand" />
                    <!-- Close -->
                    <Button Click="BtnClose_Click" Width="46" Background="Transparent" BorderThickness="0" Foreground="#ff7b72" Content="✕" FontSize="14" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MENU BAR ═══ -->
        <Border Grid.Row="1" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="#c9d1d9" VerticalAlignment="Center" Margin="8,0">
                <MenuItem Header="_File" Background="Transparent">
                    <MenuItem Header="Open Workspace..." Click="BtnBrowse_Click" Background="#161b22" Foreground="#c9d1d9"/>
                    <MenuItem x:Name="MenuRecentWorkspaces" Header="Recent Workspaces" Background="#161b22" Foreground="#c9d1d9">
                        <!-- Populated dynamically -->
                    </MenuItem>
                    <Separator Background="#30363d"/>
                    <MenuItem Header="Exit" Click="BtnClose_Click" Background="#161b22" Foreground="#c9d1d9"/>
                </MenuItem>
                <MenuItem Header="_View" Background="Transparent">
                    <MenuItem Header="Git Graph" Click="MenuGitGraph_Click" Background="#161b22" Foreground="#c9d1d9"/>
                    <MenuItem Header="Run History" Click="MenuHistory_Click" Background="#161b22" Foreground="#c9d1d9"/>
                </MenuItem>
                <MenuItem Header="_Settings" Background="Transparent">
                    <MenuItem x:Name="MenuThemeDark" Header="Theme: Dark" IsChecked="True" Click="MenuThemeDark_Click" Background="#161b22" Foreground="#c9d1d9"/>
                    <MenuItem x:Name="MenuThemeLight" Header="Theme: Light" IsChecked="False" Click="MenuThemeLight_Click" Background="#161b22" Foreground="#c9d1d9"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>                     <!-- Atom list -->
                <ColumnDefinition Width="5"/>                     <!-- Splitter -->
                <ColumnDefinition Width="400" MinWidth="300"/>    <!-- Chain builder -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Atom List -->
            <Border Grid.Column="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ATOM LIBRARY" Foreground="#8b949e"
                               FontSize="13" FontWeight="Bold" Margin="24,20,14,8"
                               />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,8,0">
                        <StackPanel x:Name="AtomListPanel" Margin="0,0,0,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#30363d" Cursor="SizeWE"/>

            <!-- RIGHT: Chain Builder -->
            <Grid Grid.Column="2" Background="#0d1117" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chain header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CHAIN BUILDER" Foreground="#8b949e"
                               FontSize="11" FontWeight="Bold"  VerticalAlignment="Center"/>
                               
                    <Button Grid.Column="1" x:Name="BtnLoadPreset" Content="📂 Load Preset" Style="{StaticResource AtomButton}"
                            Padding="8,4" Click="BtnLoadPreset_Click" FontSize="12">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PresetContextMenu" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}">
                                <!-- Render dynamically -->
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    
                    <Button Grid.Column="3" Content="🗑 Clear" Style="{StaticResource AtomButton}"
                            Padding="8,4" Click="BtnClearChain_Click" FontSize="12"/>
                </Grid>

                <!-- Chain Items (drag & drop zone) -->
                <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <!-- Empty state -->
                        <TextBlock x:Name="TxtChainEmpty"
                                   Text="← Click vào Atom bên trái để thêm vào chain"
                                   Foreground="#484f58" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="13"/>

                        <!-- Chain list -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel x:Name="ChainPanel" AllowDrop="True"
                                        Drop="ChainPanel_Drop" DragOver="ChainPanel_DragOver"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnRun" Content="▶  RUN CHAIN"
                            Style="{StaticResource RunButton}" Click="BtnRun_Click"
                            IsEnabled="False"/>
                    <Button Grid.Column="2" Content="💾 Save Preset" Style="{StaticResource AtomButton}"
                            Padding="12,8" Click="BtnSavePreset_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ HORIZONTAL SPLITTER ═══ -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      Background="#30363d" Cursor="SizeNS"/>

        <!-- ═══ TERMINAL (WebView2 + xterm.js) ═══ -->
        <Border Grid.Row="4" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Terminal top bar -->
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d"
                        BorderThickness="0,0,0,1" Padding="12,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#3fb950" Margin="0,0,6,0"/>
                            <TextBlock Text="TERMINAL" Foreground="#8b949e"
                                       FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Clear" Style="{StaticResource AtomButton}"
                                Padding="8,3" FontSize="11" Click="BtnClearTerminal_Click"/>
                    </Grid>
                </Border>

                <!-- xterm.js WebView -->
                <wv2:WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="Transparent"/>
            </DockPanel>
        </Border>

        <!-- ═══ NOTIFICATION OVERLAY ═══ -->
        <Border x:Name="NotificationToast" Style="{StaticResource NotificationToast}"
                Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotificationIcon" Text="✓" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock x:Name="NotificationMessage" Text="Success message here" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
